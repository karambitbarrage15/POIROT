# Neon PostgreSQL Serverless Connection String
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Custom Authentication Sessions (32+ chars)
JWT_SECRET="cost-detective-super-secret-key-2026-production-ready"

# OpenRouter AI Provider (Free Meta Llama 3.3 70B model)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# AWS Read-Only Credentials
AWS_ACCESS_KEY_ID="AKIAEXAMPLEID"
AWS_SECRET_ACCESS_KEY="EXAMPLESECRETKEY"
AWS_DEFAULT_REGION="ap-southeast-1"
